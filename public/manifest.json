{
  "manifest_version": 3,
  "name": "Clutch | Renown.gg extension",
  "version": "1.1.3",
  "description": "Enhance your Renown.gg experience with player stats, lobby insights, and UI improvements.",
  "icons": {
    "16": "static/icon16.png",
    "32": "static/icon32.png",
    "48": "static/icon48.png",
    "128": "static/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "static/icon16.png",
      "32": "static/icon32.png",
      "48": "static/icon48.png",
      "128": "static/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "clutch-extension@lorem.sh",
      "strict_min_version": "109.0"
    }
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://apiv2.goclutch.pro/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.renown.gg/*", "*://renown.gg/*"],
      "js": ["content.js"],
      "type": "module",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "static/*.svg",
        "static/*.png",
        "styles/*.css",
        "static/*.mp3",
        "static/*.wav"
      ],
      "matches": ["*://*.renown.gg/*", "*://renown.gg/*"]
    }
  ]
}
