{
  "manifest_version": 3,
  "name": "Clutch Extension",
  "version": "1.0.0",
  "description": "Chrome extension built with Svelte",
  "icons": {
    "16": "static/icon16.png",
    "32": "static/icon32.png",
    "48": "static/icon48.png",
    "128": "static/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "static/icon16.png",
      "32": "static/icon32.png",
      "48": "static/icon48.png",
      "128": "static/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["*://*.renown.gg/*", "*://renown.gg/*"],
      "js": ["content.js"],
      "type": "module",
      "run_at": "document_start"
    }
  ]
} 